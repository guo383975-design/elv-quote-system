# apps/api/.env.example
#
#   cp .env.example .env    # 然后按下面的说明改
#
# ⚠ 不要把真实的 .env 交付/提交到仓库（见仓库根 .gitignore）：
#   JWT_SECRET 是 HS256 的对称密钥，拿到它就能给任意用户签发令牌。

# Database
# 异步驱动给应用用（asyncpg），同步驱动只给 Alembic 用（psycopg3）。
# ⚠ 同步 URL 必须写 postgresql+psycopg:// —— 写成裸 postgresql:// 会走
#   psycopg2，而项目刻意没有依赖它（Python 3.14 下没有预编译 wheel），
#   于是"照文档 cp .env.example .env 再 alembic upgrade head"会直接
#   ModuleNotFoundError: No module named 'psycopg2'。
DATABASE_URL=postgresql+asyncpg://quote:quote@localhost:5432/quote_db
DATABASE_URL_SYNC=postgresql+psycopg://quote:quote@localhost:5432/quote_db

# JWT
# 本地开发可以用下面这行；**APP_ENV=production 时必须换掉**，
# 否则服务会拒绝启动（core/config.py: validate_for_runtime）。
# 生成：openssl rand -hex 32
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 首次引导（可选）：留空 = 自助注册完全关闭（默认，也是内网部署的推荐值）。
# 全新库需要一个"第一个管理员"时：临时填一个随机串，调一次
#   POST /api/v1/auth/register  {"username":…, "email":…, "password":…,
#                                "bootstrap_token":"<这里填的值>"}
# 注册成功后立刻删掉这一行并重启服务。
BOOTSTRAP_TOKEN=

# 高危操作闸门（2026-10-08 生产事故后新增）：是否允许「恢复出厂设置」。
# 详见 deploy/api.env 的详细说明。**默认 false = POST /settings/factory-reset 一律 403。**
# 要用就先改成 true 并重启，用完立刻改回 false 再重启。
ALLOW_FACTORY_RESET=false

# App
APP_ENV=development
APP_NAME=智能化弱电报价系统 API
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS（前端与 API 同源走 nginx 时其实是冗余的，留着方便直连 8000 调试）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# Logging
LOG_LEVEL=INFO

# 导出 PDF 用的中文字体（可选）。
# 不设时按 wqy-zenhei → Windows 系统字体的顺序自动找；
# 支持 "/path/to/font.ttc#0" 指定 .ttc 里的子字体。
# 一个都找不到时导出接口回 503 并说清缺什么，不会静默输出一堆黑方块。
# QUOTE_EXPORT_FONT=/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc#0
